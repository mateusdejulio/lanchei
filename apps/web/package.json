{
  "name": "@lanchei/web",
  "version": "0.1.0",
  "private": true,
  "description": "Caixa da cantina (tablet) e painel administrativo do Lanchei",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tablet": "vite --host --mode tablet",

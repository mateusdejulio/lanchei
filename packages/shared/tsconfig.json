{
  // O pacote é publicado como CÓDIGO-FONTE TypeScript (package.json → "exports": "./src/index.ts").
  // Quem compila é o Vite de cada app; aqui o tsc só confere os tipos.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src", "tests"]
}
